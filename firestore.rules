rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'matthew.harbert@lcps.org' ||
          request.auth.token.email.lower() == 'propellevelup@lcps.org'
        )) ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('role', '').lower() == 'admin' ||
          get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('role', '').lower() == 'super_admin' ||
          get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('role', '').lower() == 'super admin'))
      );
    }

    function isClassTeacherOrCoTeacher(classId) {
      return isAuthenticated() &&
        classId != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        (
          get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid ||
          (
            'coTeacherIds' in get(/databases/$(database)/documents/classes/$(classId)).data &&
            get(/databases/$(database)/documents/classes/$(classId)).data.coTeacherIds is list &&
            request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.coTeacherIds
          )
        );
    }

    function isTeacherOfClass(classId) {
      return isAdmin() || isClassTeacherOrCoTeacher(classId);
    }

    // Assumed Data Model for /classes/{classId}/redemptions/{redemptionId}:
    //   - rewardId: string (required, 1..128 chars, immutable)
    //   - studentId: string|null (optional, <= 128 chars, immutable)
    //   - studentName: string|null (optional, <= 128 chars, immutable)
    //   - itemName: string (required, 1..200 chars, immutable)
    //   - cost: number (required, >= 0 and <= 1000000, immutable)
    //   - directions: string|null (optional, <= 1000 chars, immutable)
    //   - status: string (required: 'pending' on create; 'fulfilled', 'rejected', 'cancelled', 'refund_requested', or 'refund_denied' on update)
    //   - redeemedAt: timestamp (optional/serverTimestamp, immutable)
    //   - cancelledAt: string|timestamp (optional, set on cancel/reject)
    //   - cancelledBy: string (optional: 'student' or 'teacher')
    //   - refunded: bool (optional, true when refunded)
    //   - refundRequestedBy: string (optional: 'student')
    //   - refundRequestedAt: string|timestamp (optional, set on student refund request)
    //   - refundReason: string (optional, <= 200 chars)
    //   - rejectionReason: string (optional, teacher-only)
    //   - updatedAt: timestamp (optional/serverTimestamp)
    function isValidRedemptionCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['rewardId', 'itemName', 'cost', 'status']) &&
             data.keys().hasOnly(['rewardId', 'studentId', 'studentName', 'itemName', 'cost', 'directions', 'status', 'redeemedAt']) &&
             data.rewardId is string && data.rewardId.size() > 0 && data.rewardId.size() <= 128 &&
             (!('studentId' in data) || data.studentId == null || (data.studentId is string && data.studentId.size() <= 128)) &&
             (!('studentName' in data) || data.studentName == null || (data.studentName is string && data.studentName.size() <= 128)) &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 200 &&
             data.cost is number && data.cost >= 0 && data.cost <= 1000000 &&
             (!('directions' in data) || data.directions == null || (data.directions is string && data.directions.size() <= 1000)) &&
             data.status == 'pending' &&
             (!('redeemedAt' in data) || data.redeemedAt is timestamp);
    }

    function isValidStudentRedemptionCancellation() {
      return resource.data.get('status', '') == 'pending' &&
             resource.data.get('refunded', false) != true &&
             request.resource.data.status == 'cancelled' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelledAt', 'cancelledBy', 'refunded', 'updatedAt'
             ]) &&
             (!('cancelledBy' in request.resource.data) || request.resource.data.cancelledBy == 'student') &&
             (!('refunded' in request.resource.data) || request.resource.data.refunded == true) &&
             (!('cancelledAt' in request.resource.data) ||
               request.resource.data.cancelledAt is timestamp ||
               (request.resource.data.cancelledAt is string && request.resource.data.cancelledAt.size() <= 64)) &&
             (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function isValidStudentRefundRequestUpdate() {
      return request.resource.data.status == 'refund_requested' &&
             (!('refunded' in request.resource.data) || request.resource.data.refunded == false) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'refundRequestedBy', 'refundRequestedAt', 'refundReason', 'updatedAt'
             ]) &&
             (!('refundRequestedBy' in request.resource.data) || request.resource.data.refundRequestedBy == 'student') &&
             (!('refundReason' in request.resource.data) ||
               (request.resource.data.refundReason is string && request.resource.data.refundReason.size() <= 200)) &&
             (!('refundRequestedAt' in request.resource.data) ||
               request.resource.data.refundRequestedAt is timestamp ||
               (request.resource.data.refundRequestedAt is string && request.resource.data.refundRequestedAt.size() <= 64)) &&
             (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function isValidStudentRedemptionRefundRequest() {
      return (resource.data.get('status', '') == 'fulfilled' ||
              resource.data.get('status', '') == 'refund_denied') &&
             (!('refunded' in resource.data) || resource.data.refunded != true) &&
             request.resource.data.get('studentId', null) == resource.data.get('studentId', null) &&
             request.resource.data.get('studentName', null) == resource.data.get('studentName', null) &&
             request.resource.data.get('itemName', null) == resource.data.get('itemName', null) &&
             request.resource.data.get('cost', null) == resource.data.get('cost', null) &&
             request.resource.data.get('rewardId', null) == resource.data.get('rewardId', null) &&
             request.resource.data.get('redeemedAt', null) == resource.data.get('redeemedAt', null) &&
             isValidStudentRefundRequestUpdate();
    }

    // Assumed Data Model for student update transitions on /stem_purchases/{purchaseId}:
    //   - fulfilled: bool (false for pending cancel; true for delivered refund request)
    //   - status: string ('pending', 'fulfilled', 'delivered', 'refund_denied', 'cancelled', 'refund_requested', 'deleted')
    //   - refunded: bool (true on cancel; false/absent on refund_requested)
    //   - cancelledBy / refundRequestedBy: string ('student')
    //   - cancelledAt / refundRequestedAt: string (<= 64 chars) | timestamp
    //   - refundReason: string (<= 200 chars)
    //   - updatedAt: timestamp
    function isValidStudentStemCancellation() {
      return resource.data.get('deleted', false) != true &&
             resource.data.get('fulfilled', false) == false &&
             (!('status' in resource.data) || resource.data.status == 'pending') &&
             (!('refunded' in resource.data) || resource.data.refunded != true) &&
             request.resource.data.status == 'cancelled' &&
             request.resource.data.refunded == true &&
             (!('cancelledBy' in request.resource.data) || request.resource.data.cancelledBy == 'student') &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelledBy', 'refunded', 'cancelledAt', 'updatedAt'
             ]) &&
             (!('cancelledAt' in request.resource.data) ||
               request.resource.data.cancelledAt is timestamp ||
               (request.resource.data.cancelledAt is string && request.resource.data.cancelledAt.size() <= 64)) &&
             (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function isValidStudentStemRefundRequest() {
      return resource.data.get('deleted', false) != true &&
             resource.data.get('fulfilled', false) == true &&
             (!('status' in resource.data) ||
              resource.data.status in ['fulfilled', 'delivered', 'pending', 'refund_denied']) &&
             (!('refunded' in resource.data) || resource.data.refunded != true) &&
             isValidStudentRefundRequestUpdate();
    }

    function isValidStudentStemAction() {
      return isValidStudentStemCancellation() || isValidStudentStemRefundRequest();
    }

    // =========================================================

    // TEACHERS
    // Any authenticated user can read teacher profiles (needed for co-teacher lookups)
    // Teachers can write their own profile, Admins can write any teacher profile
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(teacherId) || isAdmin();
    }

    // CLASSES
    match /classes/{classId} {
      // Anyone can read classes (needed to lookup by code)
      allow read: if true;

      // Only authenticated users can create classes
      allow create: if isAuthenticated();

      // Teachers, co-teachers, and admins can update anything.
      // Students (unauthenticated or not owner) can ONLY update 'studentCount'.
      allow update: if (isAuthenticated() && (
                      isAdmin()
                      || resource.data.get('teacherId', '') == request.auth.uid
                      || ('coTeacherIds' in resource.data && resource.data.coTeacherIds is list && request.auth.uid in resource.data.coTeacherIds)
                    )) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount']));

      allow delete: if isAuthenticated() && (isAdmin() || resource.data.get('teacherId', '') == request.auth.uid);
    }

    // STUDENTS
    match /students/{studentId} {
      // Allow create/update for the teacher (authenticated)
      // AND allow read/update for students (unauthenticated flow)
      // This is permissive but required for the "no-email" login flow unless we use Anon Auth.
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // SUBMISSIONS
    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if true;
      // Teachers, co-teachers, and admins can review submissions
      allow update: if isAuthenticated() && (
        isAdmin() ||
        ('classId' in resource.data && isTeacherOfClass(resource.data.classId))
      );

      // Chunks for large media/video submissions when Firebase Storage is offline/unconfigured
      match /chunks/{chunkId} {
        allow create, read: if true;
        allow delete: if isAuthenticated();
      }
    }

    // CUSTOM REWARDS (subcollection of classes)
    match /classes/{classId}/customRewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isTeacherOfClass(classId);
    }

    // REWARD REDEMPTIONS (subcollection of classes)
    match /classes/{classId}/redemptions/{redemptionId} {
      allow read: if true;
      allow create: if isValidRedemptionCreate(); // Students (unauthenticated) can redeem pending rewards
      allow update: if (isAuthenticated() && isTeacherOfClass(classId)) ||
                       isValidStudentRedemptionCancellation() ||
                       isValidStudentRedemptionRefundRequest();
      allow delete: if isAuthenticated() && isTeacherOfClass(classId);
    }

    // GUILD HALLS (subcollection of classes)
    match /classes/{classId}/guildHalls/{guildId} {
      allow read: if true;
      allow create, update: if true; // Students send cheers, update bot photo/castle; teachers award trophies
      allow delete: if isAuthenticated() && isTeacherOfClass(classId);
    }

    // STEM PURCHASES
    match /stem_purchases/{purchaseId} {
      allow read: if true;
      allow create: if true; // Students purchase items
      allow update: if isAuthenticated() || isValidStudentStemAction();
      allow delete: if isAuthenticated(); // Teachers and admins fulfill or remove purchases
    }

    // ACTIVITY LIBRARY
    match /activity_library/{activityId} {
      // Authenticated teachers can read all library activities
      allow read: if isAuthenticated();

      // Authenticated teachers can create new activities
      allow create: if isAuthenticated();

      // The author or system admins can update or delete library activities
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    // ORGANIZATIONS
    match /organizations/{orgId} {
      // Anyone can read organizations (needed for teacher registration dropdown/code search)
      allow read: if true;
      // Authenticated users can create/update/delete organizations
      allow create, update, delete: if isAuthenticated();
    }

    // ORGANIZATION CHOICE BOARD TEMPLATES
    match /orgTemplates/{templateId} {
      // Authenticated users can read and write organization templates
      allow read, write: if isAuthenticated();
    }
  }
}

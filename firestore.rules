rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'matthew.harbert@lcps.org' ||
          request.auth.token.email.lower() == 'propellevelup@lcps.org'
        )) ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isClassTeacherOrCoTeacher(classId) {
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      return classData.teacherId == request.auth.uid
        || ('coTeacherIds' in classData && classData.coTeacherIds is list && request.auth.uid in classData.coTeacherIds);
    }

    function isTeacherOfClass(classId) {
      return isAdmin() || isClassTeacherOrCoTeacher(classId);
    }

    // =========================================================

    // TEACHERS
    // Any authenticated user can read teacher profiles (needed for co-teacher lookups)
    // Teachers can write their own profile, Admins can write any teacher profile
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(teacherId) || isAdmin();
    }

    // CLASSES
    match /classes/{classId} {
      // Anyone can read classes (needed to lookup by code)
      allow read: if true;

      // Only authenticated users can create classes
      allow create: if isAuthenticated();

      // Teachers, co-teachers, and admins can update anything.
      // Students (unauthenticated or not owner) can ONLY update 'studentCount'.
      allow update: if (isAuthenticated() && (
                      isAdmin()
                      || resource.data.teacherId == request.auth.uid
                      || ('coTeacherIds' in resource.data && resource.data.coTeacherIds is list && request.auth.uid in resource.data.coTeacherIds)
                    )) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount']));

      allow delete: if isAuthenticated() && (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    // STUDENTS
    match /students/{studentId} {
      // Allow create/update for the teacher (authenticated)
      // AND allow read/update for students (unauthenticated flow)
      // This is permissive but required for the "no-email" login flow unless we use Anon Auth.
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // SUBMISSIONS
    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if true;
      // Teachers, co-teachers, and admins can review submissions
      allow update: if isAuthenticated() && isTeacherOfClass(resource.data.classId);
    }

    // CUSTOM REWARDS (subcollection of classes)
    match /classes/{classId}/customRewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isTeacherOfClass(classId);
    }

    // REWARD REDEMPTIONS (subcollection of classes)
    match /classes/{classId}/redemptions/{redemptionId} {
      allow read: if true;
      allow create: if true; // Students (unauthenticated) can redeem
      allow update: if isAuthenticated() && isTeacherOfClass(classId);
    }

    // GUILD HALLS (subcollection of classes)
    match /classes/{classId}/guildHalls/{guildId} {
      allow read: if true;
      allow create, update: if true; // Students send cheers, update bot photo/castle; teachers award trophies
      allow delete: if isAuthenticated() && isTeacherOfClass(classId);
    }

    // STEM PURCHASES
    match /stem_purchases/{purchaseId} {
      allow read: if true;
      allow create: if true; // Students purchase items
      allow update: if isAuthenticated(); // Teachers and admins fulfill purchases
    }

    // ACTIVITY LIBRARY
    match /activity_library/{activityId} {
      // Authenticated teachers can read all library activities
      allow read: if isAuthenticated();

      // Authenticated teachers can create new activities
      allow create: if isAuthenticated();

      // The author or system admins can update or delete library activities
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    // ORGANIZATIONS
    match /organizations/{orgId} {
      // Anyone can read organizations (needed for teacher registration dropdown/code search)
      allow read: if true;
      // Authenticated users can create/update/delete organizations
      allow create, update, delete: if isAuthenticated();
    }

    // ORGANIZATION CHOICE BOARD TEMPLATES
    match /orgTemplates/{templateId} {
      // Authenticated users can read and write organization templates
      allow read, write: if isAuthenticated();
    }
  }
}


